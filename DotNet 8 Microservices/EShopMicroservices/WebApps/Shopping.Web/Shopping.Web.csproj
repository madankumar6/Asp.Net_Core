<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>af16817f-9ef1-41e4-9cf2-baa6e766a054</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <EnableDefaultRazorComponentItems>true</EnableDefaultRazorComponentItems>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
    <DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
    <PackageReference Include="Refit.Reflection" Version="15.2.0" />
  </ItemGroup>

</Project>
